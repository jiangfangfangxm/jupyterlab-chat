# Application
NODE_ENV=development
LOG_LEVEL=info
RUN_MODE=once
POLL_INTERVAL_MS=300000
TASK_TIMEOUT_MS=120000
SMTP_VERIFY_ON_START=false
DEDUPE_STORE_PATH=./data/processed-emails.json

# IMAP
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=websearch@bank-risk.cn
IMAP_PASS=replace-with-password
IMAP_MAILBOX_WEBSEARCH=websearch
IMAP_MAILBOX_BROWSER=browser
IMAP_MAILBOX_DONE=已完成
IMAP_MAILBOX_FAILED=失败
IMAP_MOVE_FAILED=false

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=websearch@bank-risk.cn
SMTP_PASS=replace-with-password
SMTP_FROM_NAME=OpenClaw Mail Agent
SMTP_FROM_ADDRESS=websearch@bank-risk.cn

# Optional mail filters
ALLOWED_FROM_DOMAINS=

# OpenClaw
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_WEBSEARCH_BASE_URL=http://127.0.0.1:18789
OPENCLAW_CHAT_ENDPOINT=/v1/chat/completions
OPENCLAW_TOOL_ENDPOINT=/api/v1/tool/call
OPENCLAW_AGENT=main
OPENCLAW_API_TOKEN=
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TIMEOUT_MS=60000
OPENCLAW_WEBSEARCH_COUNT=5
OPENCLAW_WEBSEARCH_COUNTRY=CN
OPENCLAW_WEBSEARCH_LANGUAGE=zh
OPENCLAW_WEBSEARCH_FRESHNESS=
